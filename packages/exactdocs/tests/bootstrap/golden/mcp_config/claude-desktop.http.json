{
  "mcpServers": {
    "exactdocs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.16.0",
        "https://docs.example.com/mcp",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer <your-exactdocs-token>"
      }
    }
  }
}
