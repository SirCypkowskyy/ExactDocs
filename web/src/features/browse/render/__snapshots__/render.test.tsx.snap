exports[`fixture articles > a rich article, public library 1`] = `
"<div class="doc"><h3 id="payments-quickstart" class="doc-h doc-h1" hidden="">Payments quickstart<a href="#payments-quickstart" class="doc-anchor" aria-label="Link to Payments quickstart">#</a></h3>
<p>Accept a first payment in <strong>five minutes</strong>. This page covers the <em>happy path</em>, <s>the old way</s> and where to go next. See the <a href="/libraries/acme/payments?path=docs%2Fguide%2Fauth.md#api-keys">auth guide</a>, the <a href="#overview">overview</a> or the source of the schema. The <a href="https://example.com/docs?a=1&amp;b=2" target="_blank" rel="noopener noreferrer">docs site</a> is the long version, and <a href="https://example.com/bare" target="_blank" rel="noopener noreferrer">https://example.com/bare</a> is an autolink.</p>
<h4 id="overview" class="doc-h doc-h2">Overview<a href="#overview" class="doc-anchor" aria-label="Link to Overview">#</a></h4>
<p>Every request is made with <code>curl</code>, <code>fetch()</code> or an SDK. Set <code>ACME_API_KEY</code> first.</p>
<blockquote><p>Idempotency keys are kept for 24 hours. A retry with the same key returns the original response.</p>
</blockquote>
<h5 id="install" class="doc-h doc-h3">Install<a href="#install" class="doc-anchor" aria-label="Link to Install">#</a></h5>
<figure class="doc-code"><figcaption><span>bash</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>pnpm add @acme/payments
export ACME_API_KEY=&quot;sk_test_123&quot;   # never commit this</code></pre>
</figure>
<h5 id="create-a-payment" class="doc-h doc-h3">Create a payment<a href="#create-a-payment" class="doc-anchor" aria-label="Link to Create a payment">#</a></h5>
<figure class="doc-code"><figcaption><span>ts</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>import { Acme } from &quot;@acme/payments&quot;;

const acme = new Acme({ apiKey: process.env.ACME_API_KEY });

export async function charge(amount: number): Promise&lt;string&gt; {
  const payment = await acme.payments.create({ amount, currency: &quot;eur&quot; });
  return payment.id; // pay_01H…
}</code></pre>
</figure>
<figure class="doc-code"><figcaption><span>python</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>from acme import Acme

client = Acme(api_key=os.environ[&quot;ACME_API_KEY&quot;])
payment = client.payments.create(amount=1200, currency=&quot;eur&quot;, metadata={&quot;order&quot;: 42})
print(f&quot;created {payment.id}&quot;)</code></pre>
</figure>
<figure class="doc-code"><figcaption><span>json</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>{ &quot;id&quot;: &quot;pay_01H8&quot;, &quot;amount&quot;: 1200, &quot;paid&quot;: true, &quot;tags&quot;: [&quot;a&quot;, &quot;b&quot;], &quot;fee&quot;: null }</code></pre>
</figure>
<figure class="doc-code"><figcaption><span>yaml</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>retries:
  max: 3
  backoff: exponential # seconds</code></pre>
</figure>
<figure class="doc-code"><figcaption><span>diff</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>- const acme = new Acme(key);
+ const acme = new Acme({ apiKey: key });</code></pre>
</figure>
<figure class="doc-code"><figcaption><span>nolang-here</span><button type="button" class="doc-copy"><svg/><span class="min-w-[3.25rem] text-left">Copy</span><span class="sr-only">code</span></button></figcaption><pre tabindex="0"><code>plain text, not highlighted: &lt;b&gt;not bold&lt;/b&gt;</code></pre>
</figure>
<h4 id="reference" class="doc-h doc-h2">Reference<a href="#reference" class="doc-anchor" aria-label="Link to Reference">#</a></h4>
<section class="doc-table" aria-label="Table" tabindex="0"><table><thead><tr><th class="doc-left">Field</th><th class="doc-left">Type</th><th class="doc-right">Required</th><th class="doc-left">Description</th></tr>
</thead>
<tbody><tr><td class="doc-left"><code>amount</code></td><td class="doc-left">integer</td><td class="doc-right">yes</td><td class="doc-left">Smallest currency unit. 1200 is 12.00 EUR.</td></tr>
<tr><td class="doc-left"><code>currency</code></td><td class="doc-left">string</td><td class="doc-right">yes</td><td class="doc-left">Three-letter ISO code, lower case.</td></tr>
<tr><td class="doc-left"><code>metadata</code></td><td class="doc-left">object</td><td class="doc-right">no</td><td class="doc-left">Up to 20 keys; values are strings of at most 500 characters.</td></tr>
<tr><td class="doc-left"><code>description</code></td><td class="doc-left">string</td><td class="doc-right">no</td><td class="doc-left">Shown on the receipt and in the dashboard, up to 1,000 characters.</td></tr>
</tbody>
</table></section>
<h5 id="steps" class="doc-h doc-h3">Steps<a href="#steps" class="doc-anchor" aria-label="Link to Steps">#</a></h5>
<ol><li>Create the payment.</li>
<li>Confirm it on the client.<ul><li>Cards confirm at once.</li>
<li>Bank transfers confirm later, by webhook.</li>
</ul>
</li>
<li>Fulfil the order.</li>
</ol>
<ul><li class="doc-task doc-task-done"><svg/><div>Create a test key</div>
</li>
<li class="doc-task"><svg/><div>Go live</div>
</li>
<li class="doc-task"><svg/><div>Tell the team</div>
</li>
</ul>
<h5 id="pictures" class="doc-h doc-h3">Pictures<a href="#pictures" class="doc-anchor" aria-label="Link to Pictures">#</a></h5>
<p><img src="https://raw.githubusercontent.com/acme/payments/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/docs/guide/img/dashboard.png" alt="Dashboard overview" loading="lazy" decoding="async" referrerPolicy="no-referrer"/></p>
<p><span class="doc-noimage"><svg/><span>Logo from elsewhere</span></span></p>
<p><span class="doc-noimage"><svg/><span>Escapes the repo</span></span></p>
<hr/><h4 id="usage" class="doc-h doc-h2">Usage<a href="#usage" class="doc-anchor" aria-label="Link to Usage">#</a></h4>
<p>Duplicate heading, to check the anchors.</p>
<h4 id="usage-1" class="doc-h doc-h2">Usage<a href="#usage-1" class="doc-anchor" aria-label="Link to Usage">#</a></h4>
<p>A very long heading follows.</p>
<h5 id="configuring-the-retry-policy-for-webhook-deliveries-that-fail-repeatedly-across-regions-and-providers" class="doc-h doc-h3">Configuring the retry policy for webhook deliveries that fail repeatedly across regions and providers<a href="#configuring-the-retry-policy-for-webhook-deliveries-that-fail-repeatedly-across-regions-and-providers" class="doc-anchor" aria-label="Link to Configuring the retry policy for webhook deliveries that fail repeatedly across regions and providers">#</a></h5>
<p>Hard break after this line<br/>and a soft break here.</p>
<h6 id="level-four" class="doc-h doc-h4">Level four<a href="#level-four" class="doc-anchor" aria-label="Link to Level four">#</a></h6>
<h6 id="level-five" class="doc-h doc-h5">Level five<a href="#level-five" class="doc-anchor" aria-label="Link to Level five">#</a></h6>
<h6 id="level-six" class="doc-h doc-h6">Level six<a href="#level-six" class="doc-anchor" aria-label="Link to Level six">#</a></h6>
</div>
"
`;

