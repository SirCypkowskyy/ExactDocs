{
  "name": "@exactdocs/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript openapi.json --immutable -o src/shared/lib/api-schema.d.ts",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "pnpm check && pnpm lint:arch && pnpm lint:dead && pnpm lint:react",
    "lint:arch": "fallow architecture",
    "lint:dead": "fallow dead-code",
    "lint:react": "react-doctor --no-telemetry --blocking warning"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query-devtools": "^5.105.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fallow": "3.38.1",
    "jsdom": "^30.1.3",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
