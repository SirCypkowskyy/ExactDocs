{
  "name": "@exactdocs/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/check-dist.mjs && node scripts/bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript openapi.json --immutable -o src/shared/lib/api-schema.d.ts",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "pnpm check && pnpm lint:arch && pnpm lint:dead && pnpm lint:react",
    "lint:arch": "fallow architecture",
    "lint:dead": "fallow dead-code",
    "lint:react": "react-doctor --no-telemetry --blocking warning"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "^1.73.0",
    "markdown-it": "15.0.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fallow": "3.43.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "7.13.0",
    "react-doctor": "0.9.23",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
