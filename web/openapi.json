{
  "openapi": "3.1.0",
  "info": {
    "title": "ExactDocs REST API",
    "version": "1"
  },
  "paths": {
    "/api/v1/libraries": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List All",
        "operationId": "catalog-list_all",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryList"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/libraries/{owner}/{repo}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get One",
        "operationId": "catalog-get_one",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Owner"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Repo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDetail"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/libraries/{owner}/{repo}/versions/{ref}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Version",
        "operationId": "catalog-get_version",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Owner"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Repo"
            }
          },
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedVersion"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "retrieval"
        ],
        "summary": "Search",
        "operationId": "retrieval-search",
        "parameters": [
          {
            "name": "library",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Library"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Version"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Query"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchDocsResult"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChunkingOut": {
        "properties": {
          "split_level": {
            "type": "integer",
            "title": "Split Level"
          },
          "min_chars": {
            "type": "integer",
            "title": "Min Chars"
          },
          "max_chars": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Chars"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "split_level",
          "min_chars",
          "max_chars"
        ],
        "title": "ChunkingOut",
        "description": "How articles are cut into chunks."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Fields",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail",
          "fields"
        ],
        "title": "ErrorResponse",
        "description": "The one error shape of the API: a stable machine ``error`` code and a human ``detail``."
      },
      "ExcerptOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "library": {
            "type": "string",
            "title": "Library"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "source_url",
          "library",
          "version",
          "commit_sha"
        ],
        "title": "ExcerptOut",
        "description": "One verbatim excerpt with its provenance."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "description": "One invalid request field."
      },
      "HostKind": {
        "type": "string",
        "enum": [
          "github",
          "gitlab",
          "bitbucket",
          "gitea",
          "git"
        ],
        "title": "HostKind",
        "description": "Where the repository is hosted; `git` is any other HTTPS/SSH git server."
      },
      "LibraryDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "host": {
            "$ref": "#/components/schemas/HostKind"
          },
          "default_branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Branch"
          },
          "settings": {
            "$ref": "#/components/schemas/LibrarySettingsOut"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/VersionOut"
            },
            "type": "array",
            "title": "Versions"
          },
          "default_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "source_url",
          "host",
          "default_branch",
          "settings",
          "versions",
          "default_version"
        ],
        "title": "LibraryDetail",
        "description": "Everything known about one library."
      },
      "LibraryList": {
        "properties": {
          "libraries": {
            "items": {
              "$ref": "#/components/schemas/LibrarySummary"
            },
            "type": "array",
            "title": "Libraries"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass as `cursor` to get the next page; null on the last page."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "libraries",
          "next_cursor"
        ],
        "title": "LibraryList",
        "description": "A page of the libraries visible to the caller, sorted by ID."
      },
      "LibrarySettingsOut": {
        "properties": {
          "include_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Include Paths"
          },
          "exclude_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exclude Paths"
          },
          "tag_rules": {
            "items": {
              "$ref": "#/components/schemas/TagRuleOut"
            },
            "type": "array",
            "title": "Tag Rules"
          },
          "chunking": {
            "$ref": "#/components/schemas/ChunkingOut"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "include_paths",
          "exclude_paths",
          "tag_rules",
          "chunking"
        ],
        "title": "LibrarySettingsOut",
        "description": "A library's import settings."
      },
      "LibrarySummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "versions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Versions"
          },
          "default_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "versions",
          "default_version"
        ],
        "title": "LibrarySummary",
        "description": "A library and its version refs, sorted."
      },
      "RefKind": {
        "type": "string",
        "enum": [
          "tag",
          "branch",
          "commit"
        ],
        "title": "RefKind",
        "description": "What a version was imported from."
      },
      "ResolvedVersion": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "kind": {
            "$ref": "#/components/schemas/RefKind"
          },
          "commit_sha": {
            "type": "string",
            "title": "Commit Sha"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Imported At"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default",
            "description": "True for the version `/owner/repo` resolves to."
          },
          "library": {
            "type": "string",
            "title": "Library"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "kind",
          "commit_sha",
          "imported_at",
          "is_default",
          "library"
        ],
        "title": "ResolvedVersion",
        "description": "The version an ID resolved to; always states which one was used."
      },
      "SearchDocsResult": {
        "properties": {
          "excerpts": {
            "items": {
              "$ref": "#/components/schemas/ExcerptOut"
            },
            "type": "array",
            "title": "Excerpts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "excerpts"
        ],
        "title": "SearchDocsResult",
        "description": "Excerpts ordered from most to least relevant."
      },
      "TagRuleOut": {
        "properties": {
          "pattern": {
            "type": "string",
            "title": "Pattern"
          },
          "tag": {
            "type": "string",
            "title": "Tag"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pattern",
          "tag"
        ],
        "title": "TagRuleOut",
        "description": "Articles whose path matches `pattern` get `tag`."
      },
      "VersionOut": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "kind": {
            "$ref": "#/components/schemas/RefKind"
          },
          "commit_sha": {
            "type": "string",
            "title": "Commit Sha"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Imported At"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default",
            "description": "True for the version `/owner/repo` resolves to."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "kind",
          "commit_sha",
          "imported_at",
          "is_default"
        ],
        "title": "VersionOut",
        "description": "One imported version: the ref, what kind of ref it is, and the commit it stands for."
      }
    }
  }
}
