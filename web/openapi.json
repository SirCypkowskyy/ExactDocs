{
  "openapi": "3.1.0",
  "info": {
    "title": "ExactDocs REST API",
    "version": "1"
  },
  "paths": {
    "/api/v1/libraries": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List All",
        "operationId": "catalog-list_all",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryList"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/libraries/{owner}/{repo}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get One",
        "operationId": "catalog-get_one",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Owner"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Repo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySummary"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "retrieval"
        ],
        "summary": "Search",
        "operationId": "retrieval-search",
        "parameters": [
          {
            "name": "library",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Library"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Version"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Query"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchDocsResult"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be processed (error code in `error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The thing does not exist or is not visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A field is invalid (`fields` names them) or a business rule is violated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Fields",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail",
          "fields"
        ],
        "title": "ErrorResponse",
        "description": "The one error shape of the API: a stable machine ``error`` code and a human ``detail``."
      },
      "ExcerptOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "library": {
            "type": "string",
            "title": "Library"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "source_url",
          "library",
          "version",
          "commit_sha"
        ],
        "title": "ExcerptOut",
        "description": "One verbatim excerpt with its provenance."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "description": "One invalid request field."
      },
      "LibraryList": {
        "properties": {
          "libraries": {
            "items": {
              "$ref": "#/components/schemas/LibrarySummary"
            },
            "type": "array",
            "title": "Libraries"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass as `cursor` to get the next page; null on the last page."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "libraries",
          "next_cursor"
        ],
        "title": "LibraryList",
        "description": "A page of the libraries visible to the caller, sorted by name."
      },
      "LibrarySummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "versions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "versions"
        ],
        "title": "LibrarySummary",
        "description": "A library and its indexed versions, sorted ascending."
      },
      "SearchDocsResult": {
        "properties": {
          "excerpts": {
            "items": {
              "$ref": "#/components/schemas/ExcerptOut"
            },
            "type": "array",
            "title": "Excerpts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "excerpts"
        ],
        "title": "SearchDocsResult",
        "description": "Excerpts ordered from most to least relevant."
      }
    }
  }
}
